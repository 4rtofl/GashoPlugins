{
  "name": "gasho-plugins",
  "private": true,
  "type": "module",
  "description": "Gasho のプラグイン。プラグインごとのディレクトリが並ぶ",
  "workspaces": [
    "ayu-dark",
    "better-worktree-list",
    "git",
    "github",
    "github-implement",
    "github-review",
    "kanban",
    "pondering",
    "remote-control-shell",
    "session-list-rewind",
    "usage",
    "vscode-dark-2026"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "node --test --disable-warning=ExperimentalWarning \"*/test/*.test.ts\"",
    "check": "node scripts/check.ts"
  },
  "devDependencies": {
    "@gasho/plugin-sdk": "npm:@4rtofl/gasho-plugin-sdk@^1.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}

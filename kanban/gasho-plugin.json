{
  "id": "kanban",
  "name": "カンバン",
  "version": "1.1.4",
  "description": "選んだ repo の worktree と自分の Pull request を、列のボードに並べる（working server の git と gh を使う）",
  "genre": "workflow",
  "api": "1.5",
  "permissions": ["session.input", "session.launch"],
  "web": { "js": "web.js", "css": "web.css" },
  "daemon": { "js": "daemon.js" },
  "methods": {
    "options": { "kind": "read", "timeoutSeconds": 60 },
    "board": { "kind": "read", "timeoutSeconds": 30 },
    "refresh": { "kind": "read", "timeoutSeconds": 30 },
    "watch": { "kind": "write", "timeoutSeconds": 60 },
    "plugins": { "kind": "read", "timeoutSeconds": 30 },
    "exportCards": { "kind": "write", "timeoutSeconds": 30 }
  }
}
